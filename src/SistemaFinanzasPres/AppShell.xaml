<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SistemaFinanzasPres.Views"
       x:Class="SistemaFinanzasPres.AppShell"
       Title="Finanzas Personales"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Dashboard" Icon="dashboard.png"
                      ContentTemplate="{DataTemplate views:DashboardPage}" Route="dashboard" />
        <ShellContent Title="Movimientos" Icon="transactions.png"
                      ContentTemplate="{DataTemplate views:MovementsPage}" Route="movements" />
        <ShellContent Title="Presupuesto" Icon="budget.png"
                      ContentTemplate="{DataTemplate views:BudgetPage}" Route="budget" />
        <ShellContent Title="KPIs" Icon="kpis.png"
                      ContentTemplate="{DataTemplate views:KpisPage}" Route="kpis" />
        <ShellContent Title="Config" Icon="more.png"
                      ContentTemplate="{DataTemplate views:ConfigPage}" Route="config" />
    </TabBar>

</Shell>

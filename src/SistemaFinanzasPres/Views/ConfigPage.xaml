<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             x:Class="SistemaFinanzasPres.Views.ConfigPage"
             x:DataType="vm:ConfigViewModel"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!-- ── Ingreso base ─────────────────────────────── -->
            <Label Text="💰 Ingreso base mensual" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Salario neto" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding SalarioText}" Keyboard="Numeric" Placeholder="0" />
                    <Label Text="Otros ingresos recurrentes" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding OtrosText}" Keyboard="Numeric" Placeholder="0" />
                    <BoxView HeightRequest="1" Color="{StaticResource TextMuted}" Opacity="0.2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Ingreso total" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding IngresoTotal}" FontAttributes="Bold" Style="{StaticResource Body}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Disponible (sin diezmo)" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding IngresoDisponible}" FontAttributes="Bold" Style="{StaticResource Body}" TextColor="#0F766E" />
                    </Grid>
                    <Label Text="💡 Si registras ingresos en el mes (Configuración → Ingresos), se usan en lugar de este valor fijo."
                           Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Distribución 50/30/20 ───────────────────── -->
            <Label Text="🎯 Distribución del ingreso (%)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="🏠 Necesidades" Style="{StaticResource Muted}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="🎉 Deseos" Style="{StaticResource Muted}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="💰 Ahorro" Style="{StaticResource Muted}" />
                        <Entry Grid.Row="1" Grid.Column="0" Text="{Binding MetaNecText}" Keyboard="Numeric" Placeholder="50" />
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding MetaDesText}" Keyboard="Numeric" Placeholder="30" />
                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding MetaAhoText}" Keyboard="Numeric" Placeholder="20" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding MetaNecAmount}" Style="{StaticResource Muted}" TextColor="#0F766E" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding MetaDesAmount}" Style="{StaticResource Muted}" TextColor="#0F766E" />
                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding MetaAhoAmount}" Style="{StaticResource Muted}" TextColor="#0F766E" />
                    </Grid>
                    <Label Text="{Binding SumaMetasLabel}" Style="{StaticResource Muted}"
                           TextColor="{Binding SumaMetasColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Fondo de emergencia ─────────────────────── -->
            <Label Text="🏦 Fondo de emergencia" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding FondoMeses, StringFormat='Meta: {0} meses de gastos fijos'}" Style="{StaticResource Muted}" VerticalTextAlignment="Center" />
                        <Stepper Grid.Column="1" Value="{Binding FondoMeses}" Minimum="1" Maximum="12" Increment="1" />
                    </Grid>
                    <Label Text="Meta ahorro mensual mínimo (%)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding AhorroMinPctText}" Keyboard="Numeric" Placeholder="20" />
                    <Label Text="Meta ahorro mensual óptimo (%)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding AhorroOptPctText}" Keyboard="Numeric" Placeholder="30" />
                </VerticalStackLayout>
            </Border>

            <Button Text="💾 Guardar configuración" Command="{Binding SaveCommand}" Margin="0,4,0,0" />

            <!-- ── Administrar ─────────────────────────────── -->
            <Label Text="Administrar" Style="{StaticResource H2}" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="💵 Ingresos" Command="{Binding GoToIncomesCommand}" BackgroundColor="#10B981" />
                <Button Grid.Row="0" Grid.Column="1" Text="💳 Deudas" Command="{Binding GoToDebtsCommand}" BackgroundColor="#B91C1C" />
                <Button Grid.Row="1" Grid.Column="0" Text="🗂 Categorías" Command="{Binding GoToCategoriesCommand}" />
                <Button Grid.Row="1" Grid.Column="1" Text="🏦 Cuentas" Command="{Binding GoToAccountsCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

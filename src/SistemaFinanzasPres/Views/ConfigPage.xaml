<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             x:Class="SistemaFinanzasPres.Views.ConfigPage"
             x:DataType="vm:ConfigViewModel"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <Label Text="💰 Ingresos" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Salario neto mensual" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding SalarioText}" Keyboard="Numeric" />
                    <Label Text="Otros ingresos" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding OtrosText}" Keyboard="Numeric" />
                    <Label>
                        <Label.Text>
                            <MultiBinding StringFormat="Ingreso total: {0}">
                                <Binding Path="IngresoTotal" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label>
                        <Label.Text>
                            <MultiBinding StringFormat="Ingreso disponible (sin diezmo): {0}">
                                <Binding Path="IngresoDisponible" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="🎯 Metas 50/30/20 (%)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Row="0" Grid.Column="0" Text="🏠 Necesidades" Style="{StaticResource Muted}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="🎉 Deseos" Style="{StaticResource Muted}" />
                    <Label Grid.Row="0" Grid.Column="2" Text="💰 Ahorro" Style="{StaticResource Muted}" />
                    <Entry Grid.Row="1" Grid.Column="0" Text="{Binding MetaNecText}" Keyboard="Numeric" />
                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding MetaDesText}" Keyboard="Numeric" />
                    <Entry Grid.Row="1" Grid.Column="2" Text="{Binding MetaAhoText}" Keyboard="Numeric" />
                </Grid>
            </Border>

            <Label Text="🏦 Fondo de emergencia y ahorro" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Meses de gastos fijos cubiertos" Style="{StaticResource Muted}" />
                    <Stepper Value="{Binding FondoMeses}" Minimum="1" Maximum="12" Increment="1" />
                    <Label Text="{Binding FondoMeses, StringFormat='{0} meses'}" />
                    <Label Text="Meta ahorro mensual mínimo (%)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding AhorroMinPctText}" Keyboard="Numeric" />
                    <Label Text="Meta ahorro mensual óptimo (%)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding AhorroOptPctText}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar configuración" Command="{Binding SaveCommand}" />

            <Label Text="Administrar" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <Button Text="🗂 Categorías" Command="{Binding GoToCategoriesCommand}"
                    HorizontalOptions="Fill" />
            <Button Text="🏦 Cuentas" Command="{Binding GoToAccountsCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

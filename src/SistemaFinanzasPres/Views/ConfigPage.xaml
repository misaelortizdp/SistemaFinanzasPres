<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             x:Class="SistemaFinanzasPres.Views.ConfigPage"
             x:Name="pageRoot"
             x:DataType="vm:ConfigViewModel"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!-- ── Mes ─────────────────────────────────────── -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Button Grid.Column="0" Text="◀" Command="{Binding PrevMonthCommand}" WidthRequest="48" />
                <Label Grid.Column="1" Text="{Binding MonthLabel}" Style="{StaticResource H2}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Button Grid.Column="2" Text="▶" Command="{Binding NextMonthCommand}" WidthRequest="48" />
            </Grid>

            <!-- ── Ingresos del mes ─────────────────────────── -->
            <Label Text="💰 Ingresos del mes" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Aún no hay ingresos registrados este mes."
                           Style="{StaticResource Muted}"
                           IsVisible="{Binding SinIngresos}" />

                    <CollectionView ItemsSource="{Binding Ingresos}" SelectionMode="None"
                                    IsVisible="{Binding SinIngresos, Converter={StaticResource InvertedBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IncomeRow">
                                <Grid ColumnDefinitions="*,Auto" Padding="2,5">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Concept}" Style="{StaticResource Body}" FontAttributes="Bold" />
                                        <Label Style="{StaticResource Muted}" FontSize="11">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:dd MMM} · {1}">
                                                    <Binding Path="Date" />
                                                    <Binding Path="Source" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AmountLabel}"
                                           FontAttributes="Bold" TextColor="#10B981"
                                           Style="{StaticResource Body}" VerticalTextAlignment="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditIncomeCommand, Source={x:Reference pageRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="{StaticResource TextMuted}" Opacity="0.2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Ingreso total" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding IngresoTotalLabel}" FontAttributes="Bold" Style="{StaticResource Body}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="➕ Nuevo ingreso" Command="{Binding AddIncomeCommand}" />
                        <Button Grid.Column="1" Text="📋 Ver todos" Style="{StaticResource ButtonGhost}" Command="{Binding GoToIncomesCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── Diezmo / Primer Fruto ────────────────────── -->
            <Label Text="🙏 Diezmo / Primer Fruto" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="% del ingreso total" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding DiezmoPctText}" Keyboard="Numeric" Placeholder="10" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Monto diezmo" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding DiezmoAmountLabel}" FontAttributes="Bold" Style="{StaticResource Body}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource TextMuted}" Opacity="0.2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Disponible (después del diezmo)" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding IngresoDisponibleLabel}" FontAttributes="Bold" Style="{StaticResource Body}" TextColor="#0F766E" />
                    </Grid>
                    <Label Text="💡 El diezmo se descuenta directo del total. Las categorías Primer Fruto no aparecen en el presupuesto."
                           Style="{StaticResource Muted}" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Distribución 50/30/20 ───────────────────── -->
            <Label Text="🎯 Distribución del disponible (%)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="🏠 Necesidades" Style="{StaticResource Muted}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="🎉 Deseos" Style="{StaticResource Muted}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="💰 Ahorro" Style="{StaticResource Muted}" />
                        <Entry Grid.Row="1" Grid.Column="0" Text="{Binding MetaNecText}" Keyboard="Numeric" Placeholder="50" />
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding MetaDesText}" Keyboard="Numeric" Placeholder="30" />
                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding MetaAhoText}" Keyboard="Numeric" Placeholder="20" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding MetaNecAmount}" Style="{StaticResource Muted}" TextColor="#0F766E" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding MetaDesAmount}" Style="{StaticResource Muted}" TextColor="#0F766E" />
                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding MetaAhoAmount}" Style="{StaticResource Muted}" TextColor="#0F766E" />
                    </Grid>
                    <Label Text="{Binding SumaMetasLabel}" Style="{StaticResource Muted}"
                           TextColor="{Binding SumaMetasColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Fondo de emergencia ─────────────────────── -->
            <Label Text="🏦 Fondo de emergencia" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding FondoMeses, StringFormat='Meta: {0} meses de gastos fijos'}" Style="{StaticResource Muted}" VerticalTextAlignment="Center" />
                        <Stepper Grid.Column="1" Value="{Binding FondoMeses}" Minimum="1" Maximum="12" Increment="1" />
                    </Grid>
                    <Label Text="Meta ahorro mensual mínimo (%)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding AhorroMinPctText}" Keyboard="Numeric" Placeholder="20" />
                    <Label Text="Meta ahorro mensual óptimo (%)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding AhorroOptPctText}" Keyboard="Numeric" Placeholder="30" />
                </VerticalStackLayout>
            </Border>

            <Button Text="💾 Guardar configuración" Command="{Binding SaveCommand}" Margin="0,4,0,0" />

            <!-- ── Administrar ─────────────────────────────── -->
            <Label Text="Administrar" Style="{StaticResource H2}" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="💳 Deudas" Command="{Binding GoToDebtsCommand}" BackgroundColor="#B91C1C" />
                <Button Grid.Row="0" Grid.Column="1" Text="🏦 Cuentas" Command="{Binding GoToAccountsCommand}" />
                <Button Grid.Row="1" Grid.Column="0" Text="🗂 Categorías" Command="{Binding GoToCategoriesCommand}" Grid.ColumnSpan="2" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

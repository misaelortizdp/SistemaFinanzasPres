<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             xmlns:conv="clr-namespace:SistemaFinanzasPres.Converters"
             xmlns:models="clr-namespace:SistemaFinanzasPres.Models"
             x:Class="SistemaFinanzasPres.Views.DashboardPage"
             x:Name="pageRoot"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:StatusToColorConverter x:Key="StatusColor" />
            <conv:PillarToColorConverter x:Key="PillarColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Button Grid.Column="0" Text="◀" Command="{Binding PrevMonthCommand}" WidthRequest="48" />
                <Label Grid.Column="1" Text="{Binding MonthLabel}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Button Grid.Column="2" Text="▶" Command="{Binding NextMonthCommand}" WidthRequest="48" />
            </Grid>

            <Border Style="{StaticResource Card}" BackgroundColor="#FFFBEB" IsVisible="{Binding HasSugerencias}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="💡 Sugerencias" Style="{StaticResource H2}" />
                    <CollectionView ItemsSource="{Binding Sugerencias}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" Style="{StaticResource Body}" Margin="0,3" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="💰 Ingreso" Style="{StaticResource Muted}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="💸 Gastado" Style="{StaticResource Muted}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Ingreso}" Style="{StaticResource H2}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalGastado}" Style="{StaticResource H2}" />
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding IngresoSource}" Style="{StaticResource Muted}" FontSize="11" />
                    <Label Grid.Row="3" Grid.Column="0" Text="✅ Disponible" Style="{StaticResource Muted}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="💰 Tasa Ahorro" Style="{StaticResource Muted}" />
                    <Label Grid.Row="4" Grid.Column="0" Text="{Binding Disponible}" Style="{StaticResource H2}" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding TasaAhorro}" Style="{StaticResource H2}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowProjection}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="🔮 Proyección fin de mes" Style="{StaticResource H2}" />
                    <Label Text="{Binding ProjectionHeadline}" Style="{StaticResource Body}" FontAttributes="Bold"
                           TextColor="{Binding ProjectionColor}" />
                    <Label Text="{Binding DaysRemainingLabel}" Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="2" Margin="0,4,0,0">
                        <Label Grid.Row="0" Grid.Column="0" Text="Quema diaria" Style="{StaticResource Muted}" FontSize="11" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Permitida/día" Style="{StaticResource Muted}" FontSize="11" />
                        <Label Grid.Row="0" Grid.Column="2" Text="Proyectado" Style="{StaticResource Muted}" FontSize="11" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding BurnDaily}" Style="{StaticResource Body}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding AllowedDaily}" Style="{StaticResource Body}" FontAttributes="Bold" TextColor="#10B981" />
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding ProjectedSpend}" Style="{StaticResource Body}" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="🏦 Fondo de emergencia" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding StatusFondo}" FontAttributes="Bold"
                               TextColor="{Binding StatusFondo, Converter={StaticResource StatusColor}}" />
                    </Grid>
                    <ProgressBar Progress="{Binding AvanceFondoProgress}" ProgressColor="#10B981" />
                    <Label Style="{StaticResource Muted}">
                        <Label.Text>
                            <MultiBinding StringFormat="Acumulado {0} de {1} ({2}, {3} meses de gastos fijos)">
                                <Binding Path="AcumuladoFondo" />
                                <Binding Path="MetaFondo" />
                                <Binding Path="AvanceFondo" />
                                <Binding Path="MesesFondo" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding DiasConRegistroLabel, StringFormat='📅 Días con registro este mes: {0}'}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowDeudas}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="💳 Deuda total activa" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="1" FontAttributes="Bold" TextColor="#EF4444" VerticalOptions="Center">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} ({1} activas)">
                                <Binding Path="TotalDeudas" />
                                <Binding Path="DeudasActivas" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </Grid>
            </Border>

            <Label Text="📈 Resumen — últimos 6 meses" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                    <Label Grid.Row="0" Grid.Column="0" Text="Mejor mes (neto)" Style="{StaticResource Muted}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Peor mes (neto)" Style="{StaticResource Muted}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding MejorMes}" Style="{StaticResource Body}" FontAttributes="Bold" TextColor="#10B981" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding PeorMes}" Style="{StaticResource Body}" FontAttributes="Bold" TextColor="#EF4444" />
                    <Label Grid.Row="2" Grid.Column="0" Text="Tasa ahorro prom." Style="{StaticResource Muted}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="Gasto prom./mes" Style="{StaticResource Muted}" />
                    <Label Grid.Row="3" Grid.Column="0" Text="{Binding PromedioAhorro}" Style="{StaticResource Body}" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding PromedioGasto}" Style="{StaticResource Body}" FontAttributes="Bold" />
                </Grid>
            </Border>

            <Label Text="📊 Análisis 50/30/20" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding Pillars}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PillarRow">
                        <Border Style="{StaticResource Card}" Margin="0,4"
                                BackgroundColor="{Binding Name, Converter={StaticResource PillarColor}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Style="{StaticResource H2}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Status}" FontAttributes="Bold"
                                       TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                                <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Presup: {0}  ·  Gastado: {1}">
                                            <Binding Path="Budgeted" />
                                            <Binding Path="Spent" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Pct}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Meta: {0}">
                                            <Binding Path="Meta" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="🔍 Detalle por categoría" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryRow">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Pillar}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Presup {0}  ·  Gast {1}  ·  Disp {2}">
                                            <Binding Path="Budgeted" />
                                            <Binding Path="Spent" />
                                            <Binding Path="Available" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProgressLabel}" Style="{StaticResource Muted}" HorizontalTextAlignment="End" />
                                <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                             Progress="{Binding Progress}"
                                             ProgressColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Status}"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>

        <!-- Botón de acción rápida: registrar un gasto sin salir del Dashboard -->
        <Button Text="+"
                Command="{Binding AbrirQuickAddCommand}"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,20,28"
                WidthRequest="60" HeightRequest="60" CornerRadius="30"
                FontSize="28" Padding="0"
                BackgroundColor="#0F766E" TextColor="White" />

        <!-- Modal de gasto rápido -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding QuickAddAbierto}">
            <Border Style="{StaticResource Card}" Margin="20" VerticalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💸 Gasto rápido" Style="{StaticResource H2}" />

                    <Label Text="Monto" Style="{StaticResource Muted}" />
                    <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding QuickMontoText}" FontSize="22" />

                    <Label Text="Categoría" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <CollectionView ItemsSource="{Binding QuickCategoriasRecientes}" SelectionMode="None" HeightRequest="46">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Border Stroke="#0F766E" Padding="12,0" HeightRequest="36">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SeleccionarCategoriaRapidaCommand, Source={x:Reference pageRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" VerticalOptions="Center" FontSize="13" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Picker Title="Elige una categoría"
                            ItemsSource="{Binding QuickCategoriasTodas}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding QuickCategoriaSeleccionada}" />

                    <Label Text="Concepto (opcional)" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <Entry Placeholder="Ej. Almuerzo" Text="{Binding QuickConcepto}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Command="{Binding CerrarQuickAddCommand}" Style="{StaticResource ButtonGhost}" />
                        <Button Grid.Column="1" Text="Guardar" Command="{Binding GuardarQuickAddCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             x:Class="SistemaFinanzasPres.Views.DebtEditPage"
             x:DataType="vm:DebtEditViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="10">
            <Label Text="Nombre" Style="{StaticResource Muted}" />
            <Entry Text="{Binding Name}" Placeholder="Tarjeta BBVA, Crédito personal, etc." />

            <Label Text="Monto original" Style="{StaticResource Muted}" />
            <Entry Text="{Binding OriginalText}" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Saldo actual" Style="{StaticResource Muted}" />
            <Entry Text="{Binding BalanceText}" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Tasa de interés anual (%)" Style="{StaticResource Muted}" />
            <Entry Text="{Binding RateText}" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Pago mínimo mensual" Style="{StaticResource Muted}" />
            <Entry Text="{Binding MinPaymentText}" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Abono extra mensual" Style="{StaticResource Muted}" />
            <Entry Text="{Binding ExtraPaymentText}" Keyboard="Numeric" Placeholder="0" />
            <Label Text="💡 Pago mínimo + abono extra es lo que se presupuesta cada mes para esta deuda — se refleja solo en Presupuesto."
                   Style="{StaticResource Muted}" FontSize="11" />

            <Label Text="Día de pago (1-31)" Style="{StaticResource Muted}" />
            <Entry Text="{Binding DueDay}" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IsActive}" />
                <Label Text="Está activa" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <Label Text="Notas" Style="{StaticResource Muted}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,12,0,0">
                <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Guardar" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

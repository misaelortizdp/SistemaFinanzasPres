<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             x:Class="SistemaFinanzasPres.Views.IncomeEditPage"
             x:DataType="vm:IncomeEditViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="10">
            <Label Text="Fecha" Style="{StaticResource Muted}" />
            <DatePicker Date="{Binding Date}" />

            <Label Text="Concepto" Style="{StaticResource Muted}" />
            <Entry Text="{Binding Concept}" Placeholder="Quincena, bono, freelance, etc." />

            <Label Text="Monto" Style="{StaticResource Muted}" />
            <Entry Text="{Binding AmountText}" Placeholder="0" Keyboard="Numeric" />

            <Label Text="Fuente" Style="{StaticResource Muted}" />
            <Picker Title="Selecciona o escribe"
                    ItemsSource="{Binding SourceOptions}"
                    SelectedItem="{Binding Source}" />
            <Entry Text="{Binding Source}" Placeholder="Otra fuente (escribir)" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IsRecurring}" />
                <Label Text="Es un ingreso recurrente" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <Label Text="Notas" Style="{StaticResource Muted}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Guardar" Command="{Binding SaveCommand}" />
                <Button Grid.Column="2" Text="🗑" BackgroundColor="#EF4444" Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsExisting}" WidthRequest="48" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

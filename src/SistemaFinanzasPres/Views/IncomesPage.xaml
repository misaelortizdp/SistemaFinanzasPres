<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             x:Class="SistemaFinanzasPres.Views.IncomesPage"
             x:Name="pageRoot"
             x:DataType="vm:IncomesViewModel"
             Title="Ingresos">

    <Grid RowDefinitions="Auto,*,Auto" Padding="14" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Text="◀" Command="{Binding PrevMonthCommand}" WidthRequest="48" />
            <Label Grid.Column="1" Text="{Binding MonthLabel}" Style="{StaticResource H2}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Button Grid.Column="2" Text="▶" Command="{Binding NextMonthCommand}" WidthRequest="48" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,40" Spacing="6">
                        <Label Text="Sin ingresos registrados en este mes." HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                        <Label Text="Si no agregas ingresos aquí, se usa el salario configurado." HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:IncomeRow">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar" BackgroundColor="#0F766E"
                                               Command="{Binding BindingContext.EditCommand, Source={x:Reference pageRoot}}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Eliminar" BackgroundColor="#EF4444"
                                               Command="{Binding BindingContext.DeleteCommand, Source={x:Reference pageRoot}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Margin="0,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.EditCommand, Source={x:Reference pageRoot}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Concept}" FontAttributes="Bold" Style="{StaticResource Body}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding AmountLabel}" FontAttributes="Bold" Style="{StaticResource Body}" TextColor="#10B981" />
                                    <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0:dd MMM} · {1}">
                                                <Binding Path="Date" />
                                                <Binding Path="Source" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" VerticalTextAlignment="Center">
                <Label.Text>
                    <MultiBinding StringFormat="Total mes: {0}">
                        <Binding Path="TotalLabel" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Button Grid.Column="1" Text="➕ Nuevo" Command="{Binding AddCommand}" />
        </Grid>
    </Grid>
</ContentPage>

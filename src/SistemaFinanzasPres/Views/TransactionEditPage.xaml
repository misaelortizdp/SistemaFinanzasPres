<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaFinanzasPres.ViewModels"
             xmlns:m="clr-namespace:SistemaFinanzasPres.Models"
             x:Class="SistemaFinanzasPres.Views.TransactionEditPage"
             x:DataType="vm:TransactionEditViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <Label Text="Fecha" Style="{StaticResource Muted}" />
            <DatePicker Date="{Binding Date}" Format="dd MMM yyyy" />

            <Label Text="Concepto" Style="{StaticResource Muted}" />
            <Entry Text="{Binding Concept}" Placeholder="Ej. Mercado supermercado" />

            <Label Text="Valor" Style="{StaticResource Muted}" />
            <Entry Text="{Binding AmountText}" Placeholder="0" Keyboard="Numeric" />

            <Label Text="Categoría" Style="{StaticResource Muted}" />
            <Picker Title="Selecciona categoría" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Cuenta (opcional)" Style="{StaticResource Muted}" />
            <Picker Title="Cuenta" ItemsSource="{Binding Accounts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedAccount}" />

            <Label Text="Notas" Style="{StaticResource Muted}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Cancelar" Style="{StaticResource ButtonGhost}" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Guardar" Command="{Binding SaveCommand}" />
                <Button Grid.Column="2" Text="🗑" BackgroundColor="#EF4444" Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsExisting}" WidthRequest="48" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
